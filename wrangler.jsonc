{
  "name": "kkp-pomodoro",
  "compatibility_date": "2026-04-25",
  "main": "src/worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "pomodoro.kkpwebninja.com/*",
      "zone_name": "kkpwebninja.com"
    }
  ]
}
